{
  "name": "streek-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3005 --host",
    "build": "vite build && tsc",
    "build:prod": "yarn build -- --mode production",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier",
    "ios": "sudo vite build && npx capacitor-assets generate && npx cap sync ios && npx cap run ios",
    "run:ios": "sudo vite build && npx capacitor-assets generate && npx cap sync ios && npx cap open ios",
    "android": "export JAVA_HOME=`/usr/bin/java_home -v 23.0.2` && sudo vite build && npx cap sync android && npx cap run android",
    "android:dev": "export JAVA_HOME=`/usr/bin/java_home -v 23.0.2` && sudo vite build --mode development && npx cap sync android && npx cap run android",
    "check": "prettier --write . && eslint --fix"
  },
  "packageManagers": "pnpm@8.15.6",
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/core": "^7.4.4",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/push-notifications": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@capgo/capacitor-social-login": "^8.2.16",
    "@iconify-icons/twemoji": "^1.2.8",
    "@iconify/react": "^6.0.2",
    "@remixicon/react": "^4.9.0",
    "@revenuecat/purchases-capacitor": "^9.0.7",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@tanstack/router-plugin": "^1.132.0",
    "audio-recorder-polyfill": "^0.4.1",
    "autoprefixer": "^10.4.21",
    "axios": "^1.12.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.545.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.3",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "3.4.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@tanstack/eslint-config": "^0.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "web-vitals": "^5.1.0"
  }
}
