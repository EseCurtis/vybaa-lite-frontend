{
  "name": "vybaa",
  "private": true,
  "type": "module",
  "scripts": {
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check",
    "test:release": "node --test scripts/release-utils.test.mjs",
    "dev": "vite  --mode base --port 3005 --host",
    "dev:cloud": "vite  --mode development --port 3005 --host",
    "prod": "vite --mode production --port 3005 --host -- ",
    "build": "vite build",
    "build:prod": "yarn build production",
    "serve": "vite preview",
    "prepare": "git config core.hooksPath .githooks",
    "testx": "vitest run",
    "lint": "eslint",
    "format": "prettier",
    "xcode": "npx cap open ios",
    "android:build": "npx cap sync android && npx cap run android",
    "ios": "npx cap sync ios && npx cap run ios",
    "run:ios:prod": "sudo vite build --mode production && npx capacitor-assets generate && npx cap sync ios && npx cap open ios",
    "run:ios:dev": "sudo vite build --mode development && npx capacitor-assets generate && npx cap sync ios && npx cap open ios",
    "run:andy:prod": "sudo vite build --mode production && npx capacitor-assets generate && npx cap sync android && npx cap open android",
    "run:andy:dev": "sudo vite build --mode development && npx capacitor-assets generate && npx cap sync android && npx cap open android",
    "build:andy:dev": "sudo vite build --mode development && npx capacitor-assets generate && npx cap sync android",
    "run:ios": "CAPACITOR_USE_LOCAL_SERVER=true sudo vite build --mode base && CAPACITOR_USE_LOCAL_SERVER=true npx capacitor-assets generate && CAPACITOR_USE_LOCAL_SERVER=true npx cap sync ios && CAPACITOR_USE_LOCAL_SERVER=true npx cap open ios",
    "run:andy": "node scripts/run-android-local.mjs",
    "run:android": "sudo vite build && npx capacitor-assets generate && npx cap sync android && npx cap open android",
    "android": "export JAVA_HOME=`/usr/libexec/java_home -v 21` && npx cap sync android && npx cap run android",
    "android:dev": "export JAVA_HOME=`/usr/libexec/java_home -v 21` && npx cap sync android && npx cap run android",
    "check": "prettier --write . && eslint --fix"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/camera": "7.0.5",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/push-notifications": "^7.0.3",
    "@capacitor/share": "^8.0.0",
    "@capacitor/status-bar": "^7.0.3",
    "@capgo/capacitor-social-login": "7.19.1",
    "@google/genai": "^1.46.0",
    "@iconify-icons/twemoji": "^1.2.8",
    "@iconify/react": "^6.0.2",
    "@mozartec/capacitor-microphone": "^7.1.0",
    "@outray/vite": "^0.0.4",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remixicon/react": "^4.9.0",
    "@revenuecat/purchases-capacitor": "11.2.6",
    "@revenuecat/purchases-capacitor-ui": "11.2.6",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@tanstack/router-plugin": "^1.132.0",
    "audio-recorder-polyfill": "^0.4.1",
    "autoprefixer": "^10.4.21",
    "axios": "^1.12.2",
    "capacitor-plugin-safe-area": "^5.0.0",
    "capacitor-voice-recorder": "^7.0.6",
    "clsx": "^2.1.1",
    "dom-to-image-more": "^3.7.2",
    "framer-motion": "^12.23.24",
    "html2canvas": "^1.4.1",
    "ldrs": "^1.1.9",
    "lucide-react": "^0.545.0",
    "moment": "^2.30.1",
    "motion-dom": "^12.30.1",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.5.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "super-react-hooks": "^1.1.0",
    "swiper": "^12.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "3.4.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
